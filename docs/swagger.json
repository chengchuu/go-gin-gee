{
    "swagger": "2.0",
    "info": {
        "description": "API in Golang with Gin Framework",
        "contact": {
            "name": "Cheng",
            "url": "https://github.com/chengchuu",
            "email": "mazeyqian@gmail.com"
        },
        "license": {
            "name": "MIT",
            "url": "https://github.com/chengchuu/go-gin-gee/blob/main/LICENSE"
        },
        "version": "1.0"
    },
    "basePath": "/api",
    "paths": {
        "/gee/kv/get": {
            "post": {
                "description": "Public entries can be read without an API key. Private entries require X-API-Key.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "key-value"
                ],
                "summary": "Get a key-value entry",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Required only for private entries",
                        "name": "X-API-Key",
                        "in": "header"
                    },
                    {
                        "description": "Key lookup",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/controllers.GetKVRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "allOf": [
                                {
                                    "$ref": "#/definitions/http_err.APIResponse"
                                },
                                {
                                    "type": "object",
                                    "properties": {
                                        "data": {
                                            "$ref": "#/definitions/controllers.KVGetData"
                                        }
                                    }
                                }
                            ]
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/http_err.APIResponse"
                        }
                    },
                    "404": {
                        "description": "Not Found",
                        "schema": {
                            "$ref": "#/definitions/http_err.APIResponse"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/http_err.APIResponse"
                        }
                    }
                }
            }
        },
        "/gee/kv/increment": {
            "post": {
                "description": "Requires a valid X-API-Key. Missing counters start at zero; omitted delta defaults to one.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "key-value"
                ],
                "summary": "Atomically increment a counter",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Key-value API key",
                        "name": "X-API-Key",
                        "in": "header",
                        "required": true
                    },
                    {
                        "description": "Counter key and delta",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/controllers.IncrementKVRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "allOf": [
                                {
                                    "$ref": "#/definitions/http_err.APIResponse"
                                },
                                {
                                    "type": "object",
                                    "properties": {
                                        "data": {
                                            "$ref": "#/definitions/controllers.KVIncrementData"
                                        }
                                    }
                                }
                            ]
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/http_err.APIResponse"
                        }
                    },
                    "401": {
                        "description": "Unauthorized",
                        "schema": {
                            "$ref": "#/definitions/http_err.APIResponse"
                        }
                    },
                    "403": {
                        "description": "Forbidden",
                        "schema": {
                            "$ref": "#/definitions/http_err.APIResponse"
                        }
                    },
                    "409": {
                        "description": "Conflict",
                        "schema": {
                            "$ref": "#/definitions/http_err.APIResponse"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/http_err.APIResponse"
                        }
                    }
                }
            }
        },
        "/gee/kv/set": {
            "post": {
                "description": "Requires a valid X-API-Key and uses upsert semantics.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "key-value"
                ],
                "summary": "Create or replace a key-value entry",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Key-value API key",
                        "name": "X-API-Key",
                        "in": "header",
                        "required": true
                    },
                    {
                        "description": "Entry value and metadata",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/controllers.SetKVRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "allOf": [
                                {
                                    "$ref": "#/definitions/http_err.APIResponse"
                                },
                                {
                                    "type": "object",
                                    "properties": {
                                        "data": {
                                            "$ref": "#/definitions/controllers.KVSetData"
                                        }
                                    }
                                }
                            ]
                        }
                    },
                    "201": {
                        "description": "Created",
                        "schema": {
                            "allOf": [
                                {
                                    "$ref": "#/definitions/http_err.APIResponse"
                                },
                                {
                                    "type": "object",
                                    "properties": {
                                        "data": {
                                            "$ref": "#/definitions/controllers.KVSetData"
                                        }
                                    }
                                }
                            ]
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/http_err.APIResponse"
                        }
                    },
                    "401": {
                        "description": "Unauthorized",
                        "schema": {
                            "$ref": "#/definitions/http_err.APIResponse"
                        }
                    },
                    "403": {
                        "description": "Forbidden",
                        "schema": {
                            "$ref": "#/definitions/http_err.APIResponse"
                        }
                    },
                    "409": {
                        "description": "Conflict",
                        "schema": {
                            "$ref": "#/definitions/http_err.APIResponse"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/http_err.APIResponse"
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "controllers.GetKVRequest": {
            "type": "object",
            "required": [
                "key"
            ],
            "properties": {
                "key": {
                    "type": "string"
                }
            }
        },
        "controllers.IncrementKVRequest": {
            "type": "object",
            "required": [
                "key"
            ],
            "properties": {
                "delta": {
                    "type": "integer"
                },
                "key": {
                    "type": "string"
                }
            }
        },
        "controllers.KVGetData": {
            "type": "object",
            "properties": {
                "content_type": {
                    "type": "string"
                },
                "created_at": {
                    "type": "string"
                },
                "key": {
                    "type": "string"
                },
                "updated_at": {
                    "type": "string"
                },
                "value": {
                    "type": "string"
                },
                "visibility": {
                    "type": "string"
                }
            }
        },
        "controllers.KVIncrementData": {
            "type": "object",
            "properties": {
                "delta": {
                    "type": "integer"
                },
                "key": {
                    "type": "string"
                },
                "value": {
                    "type": "integer"
                }
            }
        },
        "controllers.KVSetData": {
            "type": "object",
            "properties": {
                "content_type": {
                    "type": "string"
                },
                "created": {
                    "type": "boolean"
                },
                "key": {
                    "type": "string"
                },
                "value": {
                    "type": "string"
                },
                "visibility": {
                    "type": "string"
                }
            }
        },
        "controllers.SetKVRequest": {
            "type": "object",
            "required": [
                "key"
            ],
            "properties": {
                "content_type": {
                    "type": "string",
                    "default": "text/plain"
                },
                "key": {
                    "type": "string"
                },
                "value": {
                    "type": "string"
                },
                "visibility": {
                    "type": "string",
                    "default": "private",
                    "enum": [
                        "public",
                        "private"
                    ]
                }
            }
        },
        "http_err.APIResponse": {
            "type": "object",
            "properties": {
                "code": {
                    "type": "integer"
                },
                "data": {
                    "type": "object"
                },
                "message": {
                    "type": "string"
                }
            }
        }
    }
}